{
  "name": "mobilemirror-studio",
  "version": "1.0.0",
  "description": "Professional Windows desktop application for mirroring Android and iPad screens",
  "main": "dist/main/main.js",
  "author": "MobileMirror Studio",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/start-electron.js .",
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "node scripts/start-electron.js .",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "lucide-react": "^0.294.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2",
    "vite": "^5.0.6"
  },
  "build": {
    "appId": "com.mobilemirror.studio",
    "productName": "MobileMirror Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
